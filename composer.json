{
    "name": "javaabu/form-builder",
    "description": "Dynamic forms for Laravel: versioned form definitions and entries in the database, a builder and filling UI in Blade and Inertia React built on javaabu/stencil, sections, repeating groups, wizards, cascading and conditional inputs, read-only and printable entries, fluent definitions, JSON import and export, extensible input types and an optional AI assistant",
    "homepage": "https://github.com/Javaabu/form-builder",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "form-builder",
        "dynamic-forms",
        "stencil",
        "blade",
        "inertia",
        "react",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/stencil": "^1.0@dev"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "javaabu/translatable": "^3.0@dev",
        "laravel/ai": "^1.3",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the pages with Inertia React when form-builder.views is inertia (^2.0)",
        "javaabu/translatable": "Form names, labels, help and options in every language (^3.0)",
        "laravel/ai": "The assistant that builds or edits a form from a description (^1.3)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\FormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\FormBuilder\\FormBuilderServiceProvider"
            ],
            "aliases": {
                "FormBuilder": "Javaabu\\FormBuilder\\Facades\\FormBuilder"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
